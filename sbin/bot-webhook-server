#!/usr/bin/env python3
"""bot-webhook-server — penerima update Telegram mode webhook untuk panel WIBUTUNNEL.

Kenapa ada: mode polling menahan satu koneksi panjang ke Telegram dan lambat kalau
pelanggan banyak. Mode webhook membuat Telegram yang mendorong update ke panel.

Alur: Telegram --> haproxy :443 (acl path_beg /telehook) --> 127.0.0.1:8443 (skrip ini)
      --> antrean /etc/wibutunnel/tmp/bot_webhook_queue.jsonl --> diproses bot-daemon
      (bot-daemon TIDAK memanggil getUpdates saat mode webhook, jadi tidak bentrok 409).

Keamanan (fail-closed):
  * hanya mendengar di 127.0.0.1 (tidak pernah terbuka langsung ke internet);
  * wajib header `X-Telegram-Bot-Api-Secret-Token` == WEBHOOK_SECRET dari bot.conf;
  * kalau WEBHOOK_SECRET belum diisi -> semua request ditolak 503 (tidak ada mode terbuka).
"""
import http.server
import json
import os
import socketserver
import sys
import time

LISTEN_ADDR = os.environ.get("WIBU_WEBHOOK_ADDR", "127.0.0.1")
LISTEN_PORT = int(os.environ.get("WIBU_WEBHOOK_PORT", "8443"))
BOT_CONF = os.environ.get("WIBU_BOT_CONF", "/etc/wibutunnel/bot.conf")
QUEUE_FILE = os.environ.get("WIBU_WEBHOOK_QUEUE", "/etc/wibutunnel/tmp/bot_webhook_queue.jsonl")
QUEUE_MAX_BYTES = 4 * 1024 * 1024      # jaga-jaga: antrean tak boleh tumbuh tanpa batas
SECRET_HEADER = "X-Telegram-Bot-Api-Secret-Token"


def load_secret():
    """WEBHOOK_SECRET dari bot.conf (format: KEY="value")."""
    try:
        with open(BOT_CONF, "r", encoding="utf-8", errors="ignore") as fh:
            for line in fh:
                line = line.strip()
                if line.startswith("WEBHOOK_SECRET="):
                    val = line.split("=", 1)[1].strip().strip('"').strip("'")
                    return val
    except OSError:
        return ""
    return ""


def enqueue(payload: bytes):
    os.makedirs(os.path.dirname(QUEUE_FILE), exist_ok=True)
    try:
        if os.path.exists(QUEUE_FILE) and os.path.getsize(QUEUE_FILE) > QUEUE_MAX_BYTES:
            with open(QUEUE_FILE, "w", encoding="utf-8"):
                pass                      # buang antrean yang tak terproses (bot mati lama)
        with open(QUEUE_FILE, "ab") as fh:
            fh.write(payload.rstrip(b"\r\n") + b"\n")
        os.chmod(QUEUE_FILE, 0o600)
    except OSError as exc:
        print("[WARN] gagal menulis antrean: %s" % exc, file=sys.stderr)


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "wibutunnel-webhook/1.0"
    protocol_version = "HTTP/1.1"

    def _reply(self, code, body: dict):
        raw = json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(raw)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(raw)

    def do_POST(self):                     # noqa: N802 (nama method dari http.server)
        secret = load_secret()
        if not secret:
            print("[SECURITY] WEBHOOK_SECRET belum diatur — request ditolak", file=sys.stderr)
            self._reply(503, {"error": "webhook secret not configured"})
            return
        if self.headers.get(SECRET_HEADER, "") != secret:
            print("[SECURITY] secret token tidak valid — request ditolak", file=sys.stderr)
            self._reply(403, {"error": "unauthorized"})
            return
        try:
            length = int(self.headers.get("Content-Length", 0))
        except ValueError:
            length = 0
        if length <= 0 or length > 1_000_000:
            self._reply(400, {"error": "bad length"})
            return
        payload = self.rfile.read(length)
        try:
            json.loads(payload.decode("utf-8", "ignore"))     # tolak sampah sebelum masuk antrean
        except ValueError:
            self._reply(400, {"error": "invalid json"})
            return
        enqueue(payload)
        print("[%s] update diterima (%d byte) -> antrean"
              % (time.strftime("%Y-%m-%d %H:%M:%S"), len(payload)))
        self._reply(200, {})

    def do_GET(self):                      # noqa: N802 — dipakai untuk cek kesehatan
        if self.path in ("/", "/health", "/healthz"):
            self._reply(200, {"ok": True, "service": "bot-webhook",
                              "secret_configured": bool(load_secret())})
        else:
            self._reply(404, {"error": "not found"})

    def log_message(self, fmt, *args):     # jangan tulis ke stderr (systemd sudah menangkap)
        return


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def main():
    os.makedirs(os.path.dirname(QUEUE_FILE), exist_ok=True)
    try:
        os.chmod(os.path.dirname(QUEUE_FILE), 0o700)
    except OSError:
        pass
    srv = Server((LISTEN_ADDR, LISTEN_PORT), Handler)
    print("bot-webhook mendengarkan http://%s:%d (antrean: %s, secret: %s)"
          % (LISTEN_ADDR, LISTEN_PORT, QUEUE_FILE, "ada" if load_secret() else "BELUM DIATUR"))
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        srv.server_close()


if __name__ == "__main__":
    main()
