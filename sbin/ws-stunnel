#!/usr/bin/env python3
import socket
import threading
import select
import sys
import os
import time

LISTENING_ADDR = '127.0.0.1'
LISTENING_PORT = 10015
BUFLEN = 4096 * 4
TIMEOUT = 300
DEFAULT_HOST = ('127.0.0.1', 109)
DEFAULT_RESPONSE = b'HTTP/1.1 101 <b><font color=blue>WIBUVPNSTORE</font></b>\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n'
RESPONSE_FILE = '/etc/wibutunnel/ws-response'
# Peta "port lokal ke dropbear -> IP klien" supaya panel bisa menampilkan IP
# ASLI untuk sesi SSH lewat WS (jalur 443). Tanpa ini, ss hanya melihat
# 127.0.0.1 dan IP klien hilang di hop ws-stunnel.
CLIENT_IP_FILE = '/etc/wibutunnel/tmp/ws_client_ip.log'
CLIENT_IP_KEEP = 500          # jumlah baris terakhir yang disimpan
PROXY_V2_SIG = b'\r\n\r\n\x00\r\nQUIT\n'


def proxy_v2_addr(hdr):
    """Alamat klien dari header PROXY protocol v2 (TCP atas IPv4/IPv6)."""
    try:
        fam = hdr[13]
        body = hdr[16:16 + int.from_bytes(hdr[14:16], 'big')]
        if fam == 0x11 and len(body) >= 12:      # AF_INET + STREAM
            return '.'.join(str(b) for b in body[:4])
        if fam == 0x21 and len(body) >= 36:      # AF_INET6 + STREAM
            return socket.inet_ntop(socket.AF_INET6, body[:16])
    except Exception:
        pass
    return None


def client_ip_from(req, peer_ip):
    """IP klien: CF-Connecting-IP > X-Forwarded-For (entri pertama) > PROXY/peer."""
    ip = ''
    try:
        head = req.split(b'\r\n\r\n', 1)[0].decode('latin-1', 'ignore')
    except Exception:
        head = ''
    for line in head.split('\r\n'):
        if ':' not in line:
            continue
        k, v = line.split(':', 1)
        k = k.strip().lower()
        if k == 'cf-connecting-ip':
            ip = v.strip()
            break
        if k == 'x-forwarded-for' and not ip:
            ip = v.split(',')[0].strip()
    return ip or peer_ip


def record_client_ip(local_port, ip):
    try:
        os.makedirs(os.path.dirname(CLIENT_IP_FILE), exist_ok=True)
        with open(CLIENT_IP_FILE, 'a') as f:
            f.write('%d %s %d\n' % (local_port, ip, int(time.time())))
        # rapikan: simpan CLIENT_IP_KEEP baris terakhir saja
        with open(CLIENT_IP_FILE) as f:
            lines = f.readlines()[-CLIENT_IP_KEEP:]
        with open(CLIENT_IP_FILE, 'w') as f:
            f.writelines(lines)
    except Exception:
        pass

def get_response():
    try:
        with open(RESPONSE_FILE, 'rb') as f:
            data = f.read()
            if data.strip():
                data = data.replace(b'\r\n', b'\n').replace(b'\n', b'\r\n')
                if not data.endswith(b'\r\n\r\n'):
                    data = data.rstrip(b'\r\n') + b'\r\n\r\n'
                return data
    except Exception:
        pass
    return DEFAULT_RESPONSE

class ConnectionHandler(threading.Thread):
    def __init__(self, client_sock):
        super().__init__(daemon=True)
        self.client = client_sock

    def run(self):
        target = None
        try:
            self.client.settimeout(10)

            # 1) Header PROXY protocol v2 dari haproxy (bila ada). Header ini
            #    membawa ALAMAT KLIEN ASLI: tanpa membacanya, peer di sini selalu
            #    127.0.0.1 (haproxy) dan IP klien hilang di hop ini.
            req = b''
            while len(req) < 16:
                chunk = self.client.recv(1024)
                if not chunk:
                    return
                req += chunk
            proxy_ip = None
            if req.startswith(PROXY_V2_SIG):
                plen = int.from_bytes(req[14:16], 'big')
                while len(req) < 16 + plen:
                    chunk = self.client.recv(1024)
                    if not chunk:
                        return
                    req += chunk
                proxy_ip = proxy_v2_addr(req)
                req = req[16 + plen:]

            # 2) Handshake HTTP/WebSocket dari klien
            while b'\r\n\r\n' not in req and len(req) < 8192:
                chunk = self.client.recv(1024)
                if not chunk:
                    break
                req += chunk

            if not req:
                return

            self.client.sendall(get_response())

            target = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            target.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
            self.client.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
            target.connect(DEFAULT_HOST)

            # Catat IP klien untuk sesi ini: dipetakan lewat port lokal soket
            # yang dipakai menghubungi dropbear (itulah yang terlihat di `ss`
            # sebagai peer port milik sesi dropbear).
            try:
                local_port = target.getsockname()[1]
                peer = proxy_ip or self.client.getpeername()[0]
                record_client_ip(local_port, client_ip_from(req, peer))
            except Exception:
                pass

            self.forward_clean(self.client, target)
        except Exception:
            pass
        finally:
            try: self.client.close()
            except Exception: pass
            if target:
                try: target.close()
                except Exception: pass

    def forward_clean(self, client, target):
        client_ssh_started = False
        client.setblocking(False)
        target.setblocking(False)
        sockets = [client, target]

        while True:
            r, _, _ = select.select(sockets, [], [], TIMEOUT)
            if not r:
                break
            for s in r:
                if s is target:
                    try:
                        data = target.recv(BUFLEN)
                    except Exception:
                        return
                    if not data:
                        return
                    client.sendall(data)
                else:
                    try:
                        data = client.recv(BUFLEN)
                    except Exception:
                        return
                    if not data:
                        return
                    if not client_ssh_started:
                        idx = data.find(b'SSH-')
                        if idx != -1:
                            client_ssh_started = True
                            target.sendall(data[idx:])
                        else:
                            # Discard any HTTP junk / split payload before SSH handshake
                            continue
                    else:
                        target.sendall(data)

def main():
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.bind((LISTENING_ADDR, LISTENING_PORT))
    server.listen(100)
    while True:
        try:
            client, _ = server.accept()
            ConnectionHandler(client).start()
        except Exception:
            break

if __name__ == '__main__':
    main()
