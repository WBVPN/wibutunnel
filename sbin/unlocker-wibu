#!/bin/bash
# ==========================================
# WIBU TUNNELING - unlocker-wibu (Improved v2)
# Auto Unlock with Telegram Notification
# ==========================================

# [OPT] Add flock to prevent concurrent runs from cron
exec 200>/var/lock/unlocker-wibu.lock
flock -n 200 || exit 0

load_bot_config  # [FIX] Safe parse instead of source

DB="/etc/wibutunnel/locked_users.db"
[[ ! -f "$DB" ]] && exit 0

now=$(date +%s)

while read -r line; do
    user=$(echo "$line" | cut -d: -f1)
    unlock_time=$(echo "$line" | cut -d: -f3)
    
    if [[ "$unlock_time" != "0" && "$now" -ge "$unlock_time" ]]; then
        /usr/local/bin/unlock-user "$user" "AUTO" >/dev/null 2>&1
    fi
done < "$DB"