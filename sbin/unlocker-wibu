#!/bin/bash
# ==========================================
# WIBU TUNNELING - unlocker-wibu (Improved v2)
# Auto Unlock with Telegram Notification
# ==========================================

source /etc/wibutunnel/bot.conf 2>/dev/null

DB="/etc/wibutunnel/locked_users.db"
[[ ! -f "$DB" ]] && exit 0

now=$(date -u +%s)
users_to_unlock=()

while IFS=: read -r user now_lock unlock_time reason; do
    [[ -z "$user" ]] && continue
    if [[ "$unlock_time" =~ ^[0-9]+$ && "$unlock_time" -gt 0 && "$now" -ge "$unlock_time" ]]; then
        users_to_unlock+=("$user")
    fi
done < "$DB"

for u in "${users_to_unlock[@]}"; do
    /usr/local/sbin/unlock-user "$u" "AUTO" >/dev/null 2>&1 || /usr/local/bin/unlock-user "$u" "AUTO" >/dev/null 2>&1
done