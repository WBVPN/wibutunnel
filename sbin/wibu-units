#!/bin/bash
# ==========================================
# WIBU TUNNELING - wibu-units
# Menulis/menyegarkan unit systemd yang ditambahkan SETELAH instalasi awal.
# ==========================================
# Kenapa perlu: menu [5] Update Script hanya menyelaraskan berkas (aman dari
# sha256), sedangkan unit systemd TIDAK ikut terunduh. Tanpa skrip ini, rilis
# yang memperkenalkan unit baru (mis. bot-webhook.service) akan terpasang
# setengah: berkasnya ada, layanannya tidak pernah bisa dihidupkan.
#
# Pemakaian:
#   wibu-units sync     tulis unit yang belum ada + unmask + daemon-reload
#   wibu-units status   tampilkan unit mana yang ada/aktif
set -uo pipefail

SYSTEMD_DIR="${WIBU_SYSTEMD_DIR:-/etc/systemd/system}"
DRY_RUN="${WIBU_UNITS_DRY_RUN:-0}"

ok()   { echo "[OK] $*"; }
warn() { echo "[!]  $*"; }
err()  { echo "[X]  $*" >&2; }

unit_bot_webhook() {
    cat <<'UNITEOF'
[Unit]
Description=Telegram Bot Webhook Receiver (WIBUTUNNEL)
After=network.target haproxy.service
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/bot-webhook-server
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
UNITEOF
}

services() { printf '%s\n' bot-webhook; }

write_unit() { # $1=nama unit (tanpa .service)
    local name="$1" target="${SYSTEMD_DIR}/$1.service" tmp body
    tmp="$(mktemp)"
    case "$name" in
        bot-webhook) unit_bot_webhook > "$tmp" ;;
        *) err "unit tak dikenal: $name"; rm -f "$tmp"; return 1 ;;
    esac
    if [[ -f "$target" ]] && cmp -s "$tmp" "$target"; then
        rm -f "$tmp"; ok "unit $name.service sudah sesuai"
    elif (( DRY_RUN == 1 )); then
        rm -f "$tmp"; warn "(dry-run) akan menulis $target"
    else
        install -d -m 0755 "$SYSTEMD_DIR"
        install -m 0644 "$tmp" "$target"
        rm -f "$tmp"
        ok "unit ditulis: $target"
    fi
    # unit 0 byte / symlink ke /dev/null dianggap MASKED oleh systemd -> lepaskan
    if (( DRY_RUN == 0 )) && command -v systemctl >/dev/null 2>&1; then
        if systemctl is-enabled "$name.service" 2>/dev/null | grep -q masked; then
            systemctl unmask "$name.service" >/dev/null 2>&1 && ok "unmask $name.service"
        fi
    fi
    return 0
}

cmd_sync() {
    local n=0 s
    for s in $(services); do
        write_unit "$s" && n=$((n+1))
    done
    if (( DRY_RUN == 0 )) && command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload >/dev/null 2>&1 && ok "daemon-reload"
        for s in $(services); do
            systemctl enable "$s.service" >/dev/null 2>&1 || true
        done
    fi
    ok "$n unit diselaraskan"
    return 0
}

cmd_status() {
    local s
    for s in $(services); do
        local f="${SYSTEMD_DIR}/${s}.service" st act
        if [[ ! -f "$f" ]]; then
            warn "$s.service: BELUM ADA"
            continue
        fi
        if [[ ! -s "$f" ]]; then
            err "$s.service: berkas KOSONG (systemd menganggapnya masked)"
            continue
        fi
        act="$(systemctl is-active "$s.service" 2>/dev/null || echo -)"
        st="$(systemctl is-enabled "$s.service" 2>/dev/null || echo -)"
        ok "$s.service: enabled=$st active=$act"
    done
    return 0
}

cmd_start() { # hidupkan + enable (dipakai installer)
    local s
    for s in $(services); do
        systemctl enable --now "$s.service" >/dev/null 2>&1 \
            && ok "$s.service aktif" || warn "$s.service belum bisa dihidupkan"
    done
    return 0
}

main() {
    case "${1:-sync}" in
        sync)   cmd_sync ;;
        status) cmd_status ;;
        start)  cmd_start ;;
        help|-h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' ;;
        *) err "perintah tidak dikenal: $1 (pakai: sync | status | start)"; exit 2 ;;
    esac
}

main "$@"
