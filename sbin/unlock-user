#!/bin/bash
# ==========================================
# WIBU TUNNELING - unlock-user (Improved v2)
# [PATCH] flock via safe_jq_edit_args, safe_sed_delete
# ==========================================

source /usr/local/bin/common.sh 2>/dev/null || { echo "[ERROR] common.sh not found" >&2; exit 1; }
source /etc/wibutunnel/bot.conf 2>/dev/null

user=$1
mode=$2   # AUTO atau MANUAL

[[ -z "$user" ]] && exit 1

safe_jq_edit_args --arg u "$user" '(.routing.rules[] | select(.user != null and .outboundTag == "blocked") | .user) |= map(select(. != $u))'

safe_sed_delete "$user" /etc/wibutunnel/locked_users.db

systemctl restart xray >/dev/null 2>&1

# === TELEGRAM NOTIFICATION ===
if [[ -n "$BOT_TOKEN" && -n "$CHAT_ID" ]]; then
    DOMAIN=$(cat /etc/xray/domain 2>/dev/null || echo "Unknown")
    WAKTU=$(date '+%d %b %Y %H:%M WIB')
    
    if [[ "$mode" == "AUTO" ]]; then
        CARA="Otomatis (Durasi Lock Habis)"
    else
        CARA="Manual oleh Admin"
    fi

    PESAN="
🔓 <b>USER DIBUKA KEMBALI</b>

<b>User     :</b> <code>${user}</code>
<b>Cara     :</b> ${CARA}
<b>Waktu    :</b> ${WAKTU}
<b>Domain   :</b> <code>${DOMAIN}</code>

<i>User sudah bisa login kembali.</i>
"
    curl -s --max-time 10 -X POST "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
        -F "chat_id=${CHAT_ID}" \
        -F "disable_web_page_preview=true" \
        -F "parse_mode=html" \
        -F "text=${PESAN}" >/dev/null 2>&1
fi
