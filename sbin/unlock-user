#!/bin/bash
# ==========================================
# WIBU TUNNELING - unlock-user (Improved v2)
# [PATCH] flock via safe_jq_edit_args, safe_sed_delete
# ==========================================

source /usr/local/bin/common.sh 2>/dev/null || { echo "[ERROR] common.sh not found" >&2; exit 1; }
source /etc/wibutunnel/bot.conf 2>/dev/null

user=$1
mode=$2   # AUTO atau MANUAL

[[ -z "$user" ]] && exit 1

db_delete "$user" /etc/wibutunnel/locked_users.db

if ssh_user_exists "$user"; then
    passwd -u "$user" >/dev/null 2>&1
    rm -f "/etc/wibutunnel/recovery/${user}.json"
    exp_flag=$(db_get "$user" /etc/xray/ssh_exp.conf 2>/dev/null)
    if [[ "$exp_flag" =~ ^[0-9]+:0: || "$exp_flag" == *EXPIRED* || "$exp_flag" == *QUOTA* ]]; then
        db_set /etc/xray/ssh_exp.conf "$user" "$(date -d "+1 days" +"%Y-%m-%d %H:%M:%S")"
    fi
else
    safe_jq_edit_args --arg u "$user" '(.routing.rules[] | select(.user != null and .outboundTag == "blocked") | .user) |= map(select(. != $u))'

    # Jika user ada di recovery, pulihkan client ke inbounds
    if [[ -f "/etc/wibutunnel/recovery/${user}.json" ]]; then
        rec_proto=$(jq -r '.proto // empty' "/etc/wibutunnel/recovery/${user}.json" 2>/dev/null)
        client_data=$(jq -c '.client // empty' "/etc/wibutunnel/recovery/${user}.json" 2>/dev/null)
        rec_exp=$(jq -r '.exp // empty' "/etc/wibutunnel/recovery/${user}.json" 2>/dev/null)

        if [[ -n "$client_data" && "$client_data" != "null" ]]; then
            if [[ "$rec_proto" == "VLESS" ]]; then
                safe_jq_edit_args --argjson c "$client_data" '
                    .inbounds[1].settings.clients += [$c] |
                    .inbounds[2].settings.clients += [$c] |
                    .inbounds[3].settings.clients += [$c]
                '
            elif [[ "$rec_proto" == "VMESS" ]]; then
                safe_jq_edit_args --argjson c "$client_data" '
                    .inbounds[4].settings.clients += [$c] |
                    .inbounds[5].settings.clients += [$c] |
                    .inbounds[6].settings.clients += [$c]
                '
            elif [[ "$rec_proto" == "TROJAN" ]]; then
                safe_jq_edit_args --argjson c "$client_data" '
                    .inbounds[7].settings.clients += [$c] |
                    .inbounds[8].settings.clients += [$c]
                '
            fi

            if [[ -n "$rec_exp" && "$rec_exp" != "null" && "$rec_exp" != *EXPIRED* && "$rec_exp" != *QUOTA* ]]; then
                db_set "/etc/xray/${rec_proto,,}_exp.conf" "$user" "$rec_exp"
            else
                db_set "/etc/xray/${rec_proto,,}_exp.conf" "$user" "$(date -d "+1 days" +"%Y-%m-%d %H:%M:%S")"
            fi
        fi
        rm -f "/etc/wibutunnel/recovery/${user}.json"
    fi

    proto=""
    cred=""
    if cred=$(jq -r --arg u "$user" '.inbounds[1].settings.clients[]? | select(.email == $u) | .id' "$XRAY_CONFIG" 2>/dev/null | head -n1) && [[ -n "$cred" && "$cred" != "null" ]]; then
        proto="VLESS"
    elif cred=$(jq -r --arg u "$user" '.inbounds[4].settings.clients[]? | select(.email == $u) | .id' "$XRAY_CONFIG" 2>/dev/null | head -n1) && [[ -n "$cred" && "$cred" != "null" ]]; then
        proto="VMESS"
    elif cred=$(jq -r --arg u "$user" '.inbounds[7].settings.clients[]? | select(.email == $u) | .password' "$XRAY_CONFIG" 2>/dev/null | head -n1) && [[ -n "$cred" && "$cred" != "null" ]]; then
        proto="TROJAN"
    fi

    if [[ -n "$proto" && -n "$cred" ]]; then
        xray_sync_user add "$proto" "$user" "$cred"
    else
        systemctl restart xray >/dev/null 2>&1
    fi
fi

# === TELEGRAM NOTIFICATION ===
if [[ -n "$BOT_TOKEN" && -n "$CHAT_ID" ]]; then
    DOMAIN=$(cat /etc/xray/domain 2>/dev/null || echo "Unknown")
    WAKTU=$(date '+%d %b %Y %H:%M WIB')
    
    if [[ "$mode" == "AUTO" ]]; then
        CARA="Otomatis (Durasi Lock Habis)"
    else
        CARA="Manual oleh Admin"
    fi

    PESAN="
🔓 <b>USER DIBUKA KEMBALI</b>

<b>User     :</b> <code>${user}</code>
<b>Cara     :</b> ${CARA}
<b>Waktu    :</b> ${WAKTU}
<b>Domain   :</b> <code>${DOMAIN}</code>

<i>User sudah bisa login kembali.</i>
"
    curl -s --max-time 10 -X POST "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
        -F "chat_id=${CHAT_ID}" \
        -F "disable_web_page_preview=true" \
        -F "parse_mode=html" \
        -F "text=${PESAN}" >/dev/null 2>&1
fi
