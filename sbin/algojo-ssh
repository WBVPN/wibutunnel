#!/bin/bash
# ==========================================
# WIBU TUNNELING - algojo-ssh (v4.0 Kurumi)
# SSH Session Limit Enforcement
# [FIX] Session count metric + ss parsing + 10# oktal guard + timed lock
# ==========================================
source /usr/local/bin/common.sh 2>/dev/null || { echo "[ERROR] common.sh not found" >&2; exit 1; }
source /etc/wibutunnel/bot.conf 2>/dev/null

DB_IP="/etc/wibutunnel/limit_ip.db"
DB_LOCK="/etc/wibutunnel/locked_users.db"
SSH_EXP="/etc/xray/ssh_exp.conf"
LOCK_DURATION=15

[[ ! -f "$SSH_EXP" ]] && exit 0

# ==========================================
# SSH SESSION LIMIT ENFORCEMENT
# ==========================================
declare -A locked_users=()

# Load locked users
if [[ -f "$DB_LOCK" ]]; then
    while IFS=: read -r lu _; do
        [[ -n "$lu" ]] && locked_users["$lu"]=1
    done < "$DB_LOCK"
fi

# Get active SSH sessions per user
# Sumber tunggal: ssh_sessions_snapshot() dari common.sh.
# Penting (bug nyata, VPS uji 2026-11-16): pemilik socket sesi adalah dropbear
# yang jalan sebagai ROOT, sedangkan user sebenarnya ada di KETURUNAN proses itu.
# Cara lama (`ps -o user= -p <pid-socket>`) selalu memberi "root" -> user tak ada
# di ssh_exp.conf -> sesi tak dihitung -> limit tak pernah terpicu.
declare -A user_sessions

while IFS=$'\t' read -r username _client_ip; do
    [[ -z "$username" ]] && continue
    # Skip if user not in ssh_exp.conf
    grep -q "^${username}:" "$SSH_EXP" 2>/dev/null || continue
    user_sessions[$username]=$(( ${user_sessions[$username]:-0} + 1 ))
done < <(ssh_sessions_snapshot)

# Check each user against session limit
for user in "${!user_sessions[@]}"; do
    [[ -n "${locked_users[$user]:-}" ]] && continue
    
    user_esc=$(escape_grep "$user")
    max_sess=$(grep "^${user_esc}:" "$DB_IP" 2>/dev/null | cut -d: -f2)
    # A4: validasi numerik sebelum banding. Non-numerik (DB korup) -> anggap limit 0.
    if [[ -n "$max_sess" && ! "$max_sess" =~ ^[0-9]+$ ]]; then
        echo "[WARN] algojo-ssh: limit_ip.db nilai non-numerik '$max_sess' untuk '$user', anggap 0" >&2
        max_sess=0
    fi
    [[ "$max_sess" == "0" || -z "$max_sess" ]] && continue

    sess_count=${user_sessions[$user]}

    # [FIX SSH-3] Guard against octal interpretation (08, 09, 010) + A2 guard
    if (( 10#$sess_count > 10#$max_sess )); then
        locked_users["$user"]=1
        now=$(date -u +%s)
        # A2: guard oktal 10# + fallback bila LOCK_DURATION non-numerik
        if [[ ! "$LOCK_DURATION" =~ ^[0-9]+$ ]]; then
            echo "[WARN] algojo-ssh: LOCK_DURATION non-numerik ('$LOCK_DURATION'), fallback 15 menit" >&2
            LOCK_DURATION=15
        fi
        unlock_time=$((now + (10#${LOCK_DURATION} * 60)))
        
        # Kill all user sessions
        pkill -u "$user" 2>/dev/null
        
        # Lock password (direct passwd -l, field3 > 0 for timed auto-unlock)
        passwd -l "$user" 2>/dev/null || usermod -L "$user" 2>/dev/null
        
        # A1: tulis DB via helper ber-flock (bukan append langsung)
        db_append "$user" "${now}:${unlock_time}:SSH_IP_LIMIT" "$DB_LOCK"
        
        # Telegram notification
        (
            DOMAIN=$(cat /etc/xray/domain 2>/dev/null || echo "Unknown")
            WAKTU=$(date '+%d %b %Y %H:%M WIB')
            PESAN="🔒 <b>SSH USER DIKUNCI OTOMATIS</b>

<b>User     :</b> <code>${user}</code>
<b>Alasan   :</b> Melebihi Limit Sesi (${sess_count}/${max_sess})
<b>Sesi Aktif:</b> <code>${sess_count}</code>
<b>Durasi   :</b> ${LOCK_DURATION} menit
<b>Waktu    :</b> ${WAKTU}
<b>Domain   :</b> <code>${DOMAIN}</code>

<i>Account akan otomatis dibuka setelah durasi habis.</i>"
            curl -4 -s --max-time 10 -X POST "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
                -F "chat_id=${CHAT_ID}" \
                -F "disable_web_page_preview=true" \
                -F "parse_mode=html" \
                -F "text=${PESAN}" >/dev/null 2>&1
        ) &
    fi
done

exit 0
