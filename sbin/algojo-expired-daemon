#!/bin/bash
# Continuous expiry enforcement daemon - checks every 5 seconds
source /usr/local/bin/common.sh 2>/dev/null || exit 1

while true; do
    deleted_any=""
    
    for proto_file in /etc/xray/vless_exp.conf /etc/xray/vmess_exp.conf /etc/xray/trojan_exp.conf /etc/xray/ssh_exp.conf; do
        [[ ! -f "$proto_file" ]] && continue
        
        proto=$(basename "$proto_file" | cut -d_ -f1 | tr '[:lower:]' '[:upper:]')
        NOW_LOCAL=$(date +%s)
        
        while IFS=: read -r user exp_str; do
            [[ -z "$user" || -z "$exp_str" || "$exp_str" == "Lifetime" ]] && continue
            # Baris flag recovery ditulis sebagai user:<epoch>:0:EXPIRED. IFS=: membuat exp_str
            # = epoch saja, dan `date -d <epoch>` BERHASIL, sehingga baris itu dianggap expired
            # lagi setiap tick -> notif + restart xray tak berujung.
            [[ "$exp_str" =~ ^[0-9]+$ ]] && continue
            
            exp_ts=$(date -d "$exp_str" +%s 2>/dev/null) || continue
            
            [[ $NOW_LOCAL -le $exp_ts ]] && continue

            if [[ "$proto" == "SSH" ]] && ! ssh_valid_user "$user"; then
                continue
            fi

            # Trial account = notify + delete, Regular = notify + recovery
            if [[ "$user" == trial-* ]]; then
                source /etc/wibutunnel/bot.conf 2>/dev/null
                if [[ -n "$BOT_TOKEN" && -n "$CHAT_ID" ]]; then
                    DOMAIN=$(cat /etc/xray/domain 2>/dev/null || echo "Unknown")
                    WAKTU=$(date '+%d %b %Y %H:%M WIB')
                    PESAN=$(printf '🗑 <b>TRIAL ACCOUNT DIHAPUS OTOMATIS</b>\n\n<b>User     :</b> <code>%s</code>\n<b>Protocol :</b> %s\n<b>Alasan   :</b> Expired\n<b>Waktu    :</b> %s\n<b>Domain   :</b> <code>%s</code>' "$user" "$proto" "$WAKTU" "$DOMAIN")
                    curl -s --max-time 10 -X POST "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
                        -F "chat_id=${CHAT_ID}" -F "disable_web_page_preview=true" \
                        -F "parse_mode=HTML" -F "text=${PESAN}" >/dev/null 2>&1 &
                fi
            else
                # Regular account = create recovery sidecar
                mkdir -p /etc/wibutunnel/recovery && chmod 700 /etc/wibutunnel/recovery
                
                user_esc=$(escape_grep "$user")
                if [[ "$proto" == "VLESS" ]]; then
                    jq -c --arg u "$user" --arg p "VLESS" --arg exp "$exp_str" '{user:$u, proto:$p, exp:$exp, client:(.inbounds[1].settings.clients[]? | select(.email == $u))}' "$XRAY_CONFIG" > "/etc/wibutunnel/recovery/${user}.json" 2>/dev/null
                elif [[ "$proto" == "VMESS" ]]; then
                    jq -c --arg u "$user" --arg p "VMESS" --arg exp "$exp_str" '{user:$u, proto:$p, exp:$exp, client:(.inbounds[4].settings.clients[]? | select(.email == $u))}' "$XRAY_CONFIG" > "/etc/wibutunnel/recovery/${user}.json" 2>/dev/null
                elif [[ "$proto" == "TROJAN" ]]; then
                    jq -c --arg u "$user" --arg p "TROJAN" --arg exp "$exp_str" '{user:$u, proto:$p, exp:$exp, client:(.inbounds[7].settings.clients[]? | select(.email == $u))}' "$XRAY_CONFIG" > "/etc/wibutunnel/recovery/${user}.json" 2>/dev/null
                elif [[ "$proto" == "SSH" ]]; then
                    ssh_pass=$(ssh_get_pass "$user" 2>/dev/null)
                    echo "{\"user\":\"$user\",\"proto\":\"SSH\",\"pass\":\"$ssh_pass\",\"exp\":\"$exp_str\"}" > "/etc/wibutunnel/recovery/${user}.json" 2>/dev/null
                fi
                [[ ! -s "/etc/wibutunnel/recovery/${user}.json" ]] && rm -f "/etc/wibutunnel/recovery/${user}.json"

                # Send notification
                source /etc/wibutunnel/bot.conf 2>/dev/null
                if [[ -n "$BOT_TOKEN" && -n "$CHAT_ID" ]]; then
                    DOMAIN=$(cat /etc/xray/domain 2>/dev/null || echo "Unknown")
                    WAKTU=$(date '+%d %b %Y %H:%M WIB')
                    PESAN=$(printf '💾 <b>USER PINDAH KE RECOVERY (EXPIRED)</b>\n\n<b>User     :</b> <code>%s</code>\n<b>Protocol :</b> %s\n<b>Alasan   :</b> Expired\n<b>Waktu    :</b> %s\n<b>Domain   :</b> <code>%s</code>\n\n<i>Admin bisa restore via menu-recovery dengan limit baru.</i>' "$user" "$proto" "$WAKTU" "$DOMAIN")
                    curl -s --max-time 10 -X POST "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
                        -F "chat_id=${CHAT_ID}" -F "disable_web_page_preview=true" \
                        -F "parse_mode=HTML" -F "text=${PESAN}" >/dev/null 2>&1 &
                fi
            fi

            # Delete from config
            case "$proto" in
                VLESS)
                    safe_jq_edit_args --arg u "$user" '
                        .inbounds[1].settings.clients |= map(select(.email != $u)) |
                        .inbounds[2].settings.clients |= map(select(.email != $u)) |
                        .inbounds[3].settings.clients |= map(select(.email != $u)) |
                        (.routing.rules[] | select(.user != null and .outboundTag == "blocked") | .user) |= map(select(. != $u))
                    ' >/dev/null 2>&1
                    ;;
                VMESS)
                    safe_jq_edit_args --arg u "$user" '
                        .inbounds[4].settings.clients |= map(select(.email != $u)) |
                        .inbounds[5].settings.clients |= map(select(.email != $u)) |
                        .inbounds[6].settings.clients |= map(select(.email != $u)) |
                        (.routing.rules[] | select(.user != null and .outboundTag == "blocked") | .user) |= map(select(. != $u))
                    ' >/dev/null 2>&1
                    ;;
                TROJAN)
                    safe_jq_edit_args --arg u "$user" '
                        .inbounds[7].settings.clients |= map(select(.email != $u)) |
                        .inbounds[8].settings.clients |= map(select(.email != $u)) |
                        (.routing.rules[] | select(.user != null and .outboundTag == "blocked") | .user) |= map(select(. != $u))
                    ' >/dev/null 2>&1
                    ;;
                SSH)
                    if [[ "$user" == trial-* ]]; then
                        del_ssh_user "$user" >/dev/null 2>&1
                    else
                        passwd -l "$user" >/dev/null 2>&1
                        pkill -u "$user" 2>/dev/null || true
                    fi
                    ;;
            esac

            # Cleanup: delete exp line
            # Trial = delete all DB, Regular = masuk recovery (keep limit_ip & limit_bw)
            if [[ "$user" == trial-* ]]; then
                safe_sed_delete "$user" "$proto_file"
                safe_sed_delete "$user" /etc/wibutunnel/locked_users.db
                safe_sed_delete "$user" /etc/wibutunnel/limit_ip.db
                safe_sed_delete "$user" /etc/wibutunnel/limit_bw.db
                safe_sed_delete "$user" /etc/wibutunnel/user_usage.db
                rm -f "/etc/wibutunnel/recovery/${user}.json"
            else
                # Regular: flag di exp file (proto) + DB_LOCK (daftar menu recovery)
                now_ts=$(date +%s)
                db_set "$proto_file" "$user" "${now_ts}:0:EXPIRED"
                db_set /etc/wibutunnel/locked_users.db "$user" "${now_ts}:0:EXPIRED"
            fi

            if [[ "$proto" != "SSH" ]]; then
                xray_sync_user del "$proto" "$user"
            fi
        done < "$proto_file"
    done
    
    sleep 5
done
