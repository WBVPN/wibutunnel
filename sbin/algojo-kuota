#!/bin/bash
# ==========================================
# WIBU TUNNELING - algojo-kuota (v4.0 KURUMI)
# [PATCH] flock via safe_jq_edit, unique tmp path
# ==========================================
source /usr/local/bin/common.sh 2>/dev/null || { echo "[ERROR] common.sh not found" >&2; exit 1; }
source /etc/wibutunnel/bot.conf 2>/dev/null
DB_BW="/etc/wibutunnel/limit_bw.db"
DB_USAGE="/etc/wibutunnel/user_usage.db"
DB_LOCK="/etc/wibutunnel/locked_users.db"

[[ ! -f "$DB_BW" ]] && exit 0
touch "$DB_USAGE"

xray api statsquery --server=127.0.0.1:10085 2>/dev/null | jq -r '.stat[]? | "\(.name) \(.value)"' | grep 'downlink' | grep -v 'dummy' | grep -v 'api' | awk -F'>>>' '{print $2, $NF}' | awk '{print $1, $NF}' > /etc/wibutunnel/tmp/xray_quota_raw.txt

awk '
FNR==NR { curr[$1] = $2; next }
{
    if ($1 in curr) {
        c = curr[$1]
        delta = (c < $3) ? c : (c - $3)
        $2 += delta
        $3 = c
        seen[$1] = 1
    }
    print $1 ":" $2 ":" $3
}
END {
    for (u in curr) {
        if (!seen[u]) print u ":" curr[u] ":" curr[u]
    }
}' /etc/wibutunnel/tmp/xray_quota_raw.txt FS=":" OFS=":" "$DB_USAGE" > /etc/wibutunnel/tmp/db_usage.tmp && mv /etc/wibutunnel/tmp/db_usage.tmp "$DB_USAGE"

USERS_TO_LOCK=()
while read -r line; do
    user=$(echo "$line" | cut -d: -f1)
    limit_gb=$(echo "$line" | cut -d: -f2)
    [[ "$limit_gb" == "0" || -z "$limit_gb" ]] && continue

    user_esc=$(escape_grep "$user")
    total_bytes=$(grep "^${user_esc}:" "$DB_USAGE" | cut -d: -f2)
    [[ -z "$total_bytes" ]] && total_bytes=0
    usage_gb=$(echo "scale=2; $total_bytes / 1073741824" | bc)

    if (( $(echo "$usage_gb >= $limit_gb" | bc -l) )); then
        # Sudah ditangani sebelumnya (user sudah tidak ada di config) -> jangan notif ulang
        if ! jq -e --arg u "$user" '[.inbounds[].settings.clients[]? | (.email // .password)] | index($u) != null' "$XRAY_CONFIG" >/dev/null 2>&1; then
            continue
        fi
        if ! grep -q "^${user_esc}:" "$DB_LOCK"; then
            proto="UNKNOWN"
            if grep -q "^${user_esc}:" /etc/xray/vless_exp.conf 2>/dev/null; then proto="VLESS"
            elif grep -q "^${user_esc}:" /etc/xray/vmess_exp.conf 2>/dev/null; then proto="VMESS"
            elif grep -q "^${user_esc}:" /etc/xray/trojan_exp.conf 2>/dev/null; then proto="TROJAN"; fi

            # Trial account = delete, regular = lock
            if [[ "$user" =~ ^trial- ]]; then
                safe_jq_edit_args --arg u "$user" '
                    .inbounds[1].settings.clients |= map(select(.email != $u)) |
                    .inbounds[2].settings.clients |= map(select(.email != $u)) |
                    .inbounds[3].settings.clients |= map(select(.email != $u)) |
                    .inbounds[4].settings.clients |= map(select(.email != $u)) |
                    .inbounds[5].settings.clients |= map(select(.email != $u)) |
                    .inbounds[6].settings.clients |= map(select(.email != $u)) |
                    .inbounds[7].settings.clients |= map(select(.email != $u)) |
                    .inbounds[8].settings.clients |= map(select(.email != $u)) |
                    (.routing.rules[] | select(.user != null and .outboundTag == "blocked") | .user) |= map(select(. != $u))
                '
                safe_sed_delete "$user" /etc/xray/vless_exp.conf
                safe_sed_delete "$user" /etc/xray/vmess_exp.conf
                safe_sed_delete "$user" /etc/xray/trojan_exp.conf
                safe_sed_delete "$user" /etc/wibutunnel/limit_ip.db
                safe_sed_delete "$user" /etc/wibutunnel/limit_bw.db
                safe_sed_delete "$user" /etc/wibutunnel/locked_users.db
                safe_sed_delete "$user" /etc/wibutunnel/user_usage.db
                rm -f "/etc/wibutunnel/recovery/${user}.json"
                (
                    DOMAIN=$(cat /etc/xray/domain 2>/dev/null || echo "Unknown")
                    WAKTU=$(date '+%d %b %Y %H:%M WIB')
                    PESAN=$(printf "🗑 <b>TRIAL ACCOUNT DIHAPUS OTOMATIS</b>\n\n<b>User     :</b> <code>%s</code>\n<b>Protocol :</b> %s\n<b>Alasan   :</b> Kuota Habis\n<b>Waktu    :</b> %s\n<b>Domain   :</b> <code>%s</code>" "$user" "$proto" "$WAKTU" "$DOMAIN")
                    curl -s --max-time 10 -X POST "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
                        -F "chat_id=${CHAT_ID}" \
                        -F "disable_web_page_preview=true" \
                        -F "parse_mode=html" \
                        -F "text=${PESAN}" >/dev/null 2>&1
                ) &
            else
                # Regular account = delete + recovery (sama seperti manual delete)
                # 1. Buat sidecar untuk recovery
                mkdir -p /etc/wibutunnel/recovery && chmod 700 /etc/wibutunnel/recovery
                
                if grep -q "^${user_esc}:" /etc/xray/vless_exp.conf 2>/dev/null; then
                    jq -c --arg u "$user" --arg p "VLESS" '{user:$u, proto:$p, client:(.inbounds[1].settings.clients[]? | select(.email == $u))}' "$XRAY_CONFIG" > "/etc/wibutunnel/recovery/${user}.json" 2>/dev/null
                elif grep -q "^${user_esc}:" /etc/xray/vmess_exp.conf 2>/dev/null; then
                    jq -c --arg u "$user" --arg p "VMESS" '{user:$u, proto:$p, client:(.inbounds[4].settings.clients[]? | select(.email == $u))}' "$XRAY_CONFIG" > "/etc/wibutunnel/recovery/${user}.json" 2>/dev/null
                elif grep -q "^${user_esc}:" /etc/xray/trojan_exp.conf 2>/dev/null; then
                    jq -c --arg u "$user" --arg p "TROJAN" '{user:$u, proto:$p, client:(.inbounds[7].settings.clients[]? | select(.email == $u))}' "$XRAY_CONFIG" > "/etc/wibutunnel/recovery/${user}.json" 2>/dev/null
                fi
                [[ ! -s "/etc/wibutunnel/recovery/${user}.json" ]] && rm -f "/etc/wibutunnel/recovery/${user}.json"

                # 2. Delete dari config
                safe_jq_edit_args --arg u "$user" '
                    .inbounds[1].settings.clients |= map(select(.email != $u)) |
                    .inbounds[2].settings.clients |= map(select(.email != $u)) |
                    .inbounds[3].settings.clients |= map(select(.email != $u)) |
                    .inbounds[4].settings.clients |= map(select(.email != $u)) |
                    .inbounds[5].settings.clients |= map(select(.email != $u)) |
                    .inbounds[6].settings.clients |= map(select(.email != $u)) |
                    .inbounds[7].settings.clients |= map(select(.email != $u)) |
                    .inbounds[8].settings.clients |= map(select(.email != $u)) |
                    (.routing.rules[] | select(.user != null and .outboundTag == "blocked") | .user) |= map(select(. != $u))
                '

                # 3. Delete dari exp files & DBs
                safe_sed_delete "$user" /etc/xray/vless_exp.conf
                safe_sed_delete "$user" /etc/xray/vmess_exp.conf
                safe_sed_delete "$user" /etc/xray/trojan_exp.conf
                safe_sed_delete "$user" /etc/wibutunnel/locked_users.db
                # limit_ip.db dan limit_bw.db TIDAK dihapus — akan dipakai saat restore
                # user_usage.db TIDAK dihapus —histori tetap ada

                # 4. Daftarkan ke recovery: flag di exp file (proto) + DB_LOCK (daftar menu)
                now_ts=$(date +%s)
                db_set "/etc/xray/${proto,,}_exp.conf" "$user" "${now_ts}:0:QUOTA_EXCEEDED"
                db_set "$DB_LOCK" "$user" "${now_ts}:0:QUOTA_EXCEEDED"

                # 5. Notif Telegram
                (
                    DOMAIN=$(cat /etc/xray/domain 2>/dev/null || echo "Unknown")
                    WAKTU=$(date '+%d %b %Y %H:%M WIB')
                    PESAN=$(printf "💾 <b>USER PINDAH KE RECOVERY (KUOTA HABIS)</b>\n\n<b>User     :</b> <code>%s</code>\n<b>Protocol :</b> %s\n<b>Alasan   :</b> Kuota Habis\n<b>Waktu    :</b> %s\n<b>Domain   :</b> <code>%s</code>\n\n<i>Admin bisa restore via menu-recovery dengan limit baru.</i>" "$user" "$proto" "$WAKTU" "$DOMAIN")
                    curl -s --max-time 10 -X POST "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" -F "chat_id=${CHAT_ID}" -F "disable_web_page_preview=true" -F "parse_mode=html" -F "text=${PESAN}" >/dev/null 2>&1
                ) &

                xray_sync_user del "$proto" "$user"
            fi
        fi
    fi
done < "$DB_BW"
rm -f /etc/wibutunnel/tmp/xray_quota_raw.txt
