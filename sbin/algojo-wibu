#!/bin/bash
# ==========================================
# WIBU TUNNELING - algojo-wibu (v4.0 Kurumi)
# [PATCH] flock via safe_jq_edit, unique tmp path
# ==========================================
source /usr/local/bin/common.sh 2>/dev/null || { echo "[ERROR] common.sh not found" >&2; exit 1; }
source /etc/wibutunnel/bot.conf 2>/dev/null
DB_IP="/etc/wibutunnel/limit_ip.db"
DB_LOCK="/etc/wibutunnel/locked_users.db"
LOCK_CONF="/etc/wibutunnel/lock.conf"

LOCK_DURATION=15
if [ -f "$LOCK_CONF" ]; then source "$LOCK_CONF"; fi
[[ ! -f "$DB_IP" ]] && exit 0

# [MATA ELANG V2] Deteksi real IP via Log 3 Menit
THRESH=$(date -d '3 minutes ago' +'%Y/%m/%d %H:%M:%S')
LOGIN_DATA=$(awk -v thresh="$THRESH" '{ if($1 ~ /^[0-9]{4}\/[0-9]{2}\/[0-9]{2}$/ && $1" "$2 < thresh) exit; if(/accepted/){ for(i=1;i<=NF;i++){ if($i=="accepted"){ ip=$(i-1); sub(/^(tcp|udp):/, "", ip); sub(/:[0-9]+$/, "", ip); break } }; email=$NF; gsub(/[ \t\r\n]+$/, "", email); if(email != "dummy" && email != "api" && ip != "127.0.0.1" && ip != "") { if (!seen[email, ip]++) { ips[email] = (ips[email] ? ips[email]" " : "") ip; } } } } END { for (e in ips) print e, ips[e] }' <(tac /var/log/xray/access.log 2>/dev/null) 2>/dev/null)

USERS_TO_LOCK=()
while read -r email ip_list; do
    if [[ -z "$email" || -z "$ip_list" ]]; then continue; fi
    max_ip=$(db_lookup "$email" "$DB_IP" | cut -d: -f2)
    [[ "$max_ip" == "0" || -z "$max_ip" ]] && continue

    ip_count=$(echo "$ip_list" | wc -w)
    if [[ $ip_count -gt $max_ip ]]; then
        if ! db_has "$email" "$DB_LOCK"; then
            proto="UNKNOWN"
            db_has "$email" /etc/xray/vless_exp.conf && proto="VLESS"
            db_has "$email" /etc/xray/vmess_exp.conf && proto="VMESS"
            db_has "$email" /etc/xray/trojan_exp.conf && proto="TROJAN"

            now=$(date +%s)
            unlock_time=$((now + (LOCK_DURATION * 60)))
            echo "${email}:${now}:${unlock_time}:IP_LIMIT" >> "$DB_LOCK"

            USERS_TO_LOCK+=("$email")

            (
                DOMAIN=$(cat /etc/xray/domain 2>/dev/null || echo "Unknown")
                WAKTU=$(date '+%d %b %Y %H:%M WIB')
                THICKLINE=$(printf '\u2501%.0s' {1..24})
                PESAN="🔒 <b>USER DIKUNCI OTOMATIS</b>
${THICKLINE}
<code>User        : ${email}</code>
<code>Alasan      : Melebihi Limit IP</code>
<code>Durasi      : ${LOCK_DURATION} menit</code>
${THICKLINE}
<code>Host        : ${DOMAIN}</code>
<code>Waktu       : ${WAKTU}</code>
${THICKLINE}
<i>Account akan otomatis dibuka setelah durasi habis.</i>"
                curl -s --max-time 10 -X POST "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" --data-urlencode "chat_id=${CHAT_ID}" --data-urlencode "disable_web_page_preview=true" --data-urlencode "parse_mode=html" --data-urlencode "text=${PESAN}" >/dev/null 2>&1
            ) &
        fi
    fi
done <<< "$LOGIN_DATA"

# ==========================================
# SSH TUNNEL: limit IP (multi-login) untuk akun dropbear
# ==========================================
# Untuk SSH, "limit IP" = batas sesi simultan. Hitung sesi aktif per user;
# bila melampaui batas, kunci sementara (sama seperti xray IP-limit).
while read -r ssh_user; do
    [[ -z "$ssh_user" || "$ssh_user" == *"dummy"* ]] && continue
    max_ip=$(db_lookup "$ssh_user" "$DB_IP" | cut -d: -f2)
    [[ "$max_ip" == "0" || -z "$max_ip" ]] && continue
    db_has "$ssh_user" "$DB_LOCK" && continue

    sess_count=$(ssh_session_count "$ssh_user")
    [[ "$sess_count" -le "$max_ip" ]] && continue

    now=$(date +%s)
    unlock_time=$((now + (LOCK_DURATION * 60)))
    echo "${ssh_user}:${now}:${unlock_time}:IP_LIMIT" >> "$DB_LOCK"
    pkill -u "$ssh_user" 2>/dev/null

    USERS_TO_LOCK+=("$ssh_user")
    (
        DOMAIN=$(cat /etc/xray/domain 2>/dev/null || echo "Unknown")
        WAKTU=$(date '+%d %b %Y %H:%M WIB')
        THICKLINE=$(printf '\u2501%.0s' {1..24})
        PESAN="🔒 <b>SSH USER DIKUNCI OTOMATIS</b>
${THICKLINE}
<code>User        : ${ssh_user}</code>
<code>Alasan      : Melebihi Limit IP/Sesi (${sess_count} > ${max_ip})</code>
<code>Durasi      : ${LOCK_DURATION} menit</code>
${THICKLINE}
<code>Host        : ${DOMAIN}</code>
<code>Waktu       : ${WAKTU}</code>
${THICKLINE}
<i>Account akan otomatis dibuka setelah durasi habis.</i>"
        curl -s --max-time 10 -X POST "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" --data-urlencode "chat_id=${CHAT_ID}" --data-urlencode "parse_mode=html" --data-urlencode "text=${PESAN}" >/dev/null 2>&1
    ) &
done < <(ssh_list_users)

if [[ ${#USERS_TO_LOCK[@]} -gt 0 ]]; then
    jq_args=()
    for usr in "${USERS_TO_LOCK[@]}"; do
        jq_args+=("$usr")
    done
    if safe_jq_edit_args --argjson users "$(printf '%s\n' "${jq_args[@]}" | jq -R . | jq -s .)" '(.routing.rules[] | select(.outboundTag == "blocked" and .user != null) | .user) |= (. + $users | unique)'; then
        systemctl restart xray >/dev/null 2>&1
    else
        echo "[ERROR] algojo-wibu: gagal mengedit config xray" >&2
    fi
fi
