#!/bin/bash
# ==========================================
# WIBU TUNNELING - unlocker-wibu (Improved v3)
# Auto Unlock with Telegram Notification
# [PATCH] Mendukung akun SSH (kunci = passwd -l) selain klien xray
#         (kunci = routing blocked). Restart xray maksimal 1x per run.
# ==========================================

source /usr/local/bin/common.sh 2>/dev/null || exit 1
load_bot_conf

DB="/etc/wibutunnel/locked_users.db"
XRAY_EXPS="/etc/xray/vless_exp.conf /etc/xray/vmess_exp.conf /etc/xray/trojan_exp.conf"
[[ ! -f "$DB" ]] && exit 0

now=$(date +%s)
unlocked_xray=0
unlocked_ssh=0
SSH_UNLOCKED_LIST=""

# apakah user terdaftar sebagai klien xray?
is_xray_user() {
    local u="$1" f
    for f in $XRAY_EXPS; do
        [[ -f "$f" ]] && db_has "$u" "$f" && return 0
    done
    return 1
}

while read -r line; do
    [[ -z "$line" ]] && continue
    user=$(echo "$line" | cut -d: -f1)
    unlock_time=$(echo "$line" | cut -d: -f3)
    reason=$(echo "$line" | cut -d: -f4)

    # unlock_time 0 = permanen (kuota habis / lock manual) -> skip
    [[ "$unlock_time" != "0" && "$now" -ge "$unlock_time" ]] || continue

    if is_xray_user "$user"; then
        # klien xray: lepas dari routing blocked
        # NORESTART: xray direstart satu kali setelah loop selesai
        if /usr/local/bin/unlock-user "$user" "AUTO" "NORESTART" >/dev/null 2>&1; then
            unlocked_xray=$((unlocked_xray+1))
        fi
    elif ssh_user_exists "$user" 2>/dev/null; then
        # akun SSH: buka kunci passwd -l + hapus dari DB lock
        if unlock_ssh_user "$user" 2>/dev/null; then
            unlocked_ssh=$((unlocked_ssh+1))
            SSH_UNLOCKED_LIST+="${user} "
        fi
    else
        # user sudah tidak ada (dihapus) -> bersihkan barisnya saja
        safe_sed_delete "$user" "$DB"
    fi
done < "$DB"

# [FIX] Restart xray sekali saja (hanya kalau ada klien xray yang diunlock)
if [[ "$unlocked_xray" -gt 0 ]]; then
    systemctl restart xray >/dev/null 2>&1
fi

# Notifikasi untuk akun SSH yang di-unlock
if [[ -n "$SSH_UNLOCKED_LIST" && -n "$BOT_TOKEN" && -n "$CHAT_ID" ]]; then
    (
        DOMAIN=$(cat /etc/xray/domain 2>/dev/null || echo "Unknown")
        WAKTU=$(date '+%d %b %Y %H:%M WIB')
        LIST=$(echo "$SSH_UNLOCKED_LIST" | sed 's/ /, /g' | sed 's/, *$//')
        PESAN="🔓 <b>SSH USER DIKUNCI OTOMATIS - SELESAI</b>

<b>User     :</b> <code>${LIST}</code>
<b>Alasan   :</b> Durasi lock IP-limit telah habis
<b>Waktu    :</b> ${WAKTU}
<b>Domain   :</b> <code>${DOMAIN}</code>

<i>Akun sudah dibuka kembali dan dapat digunakan.</i>"
        tg_curl -X POST sendMessage \
            -F "chat_id=${CHAT_ID}" -F "parse_mode=html" -F "text=${PESAN}" >/dev/null 2>&1
    ) &
fi

exit 0
